# PharmStock V2 configuration contract. Never place real secrets in this file.
APP_ENV=development
LOG_LEVEL=INFO

# Stage 1/2 catalog and simulator configuration
DRUG_CATALOG_DEFAULT_MARKET=EG
SIMULATION_MARKET_CODE=EG
SIMULATION_TIMEZONE=Africa/Cairo
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENFDA_API_KEY=
PHARMACY_COUNT=1000
TARGET_EVENTS_PER_SECOND=250

# Stage 3A local Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=pharmstock-local


# Stage 4A Spark Structured Streaming (inside Docker)
SPARK_STAGE4A_OUTPUT=/opt/pharmstock/artifacts/stage4a
SPARK_STAGE4A_CHECKPOINT=/opt/pharmstock/artifacts/stage4a/spark_checkpoint
SPARK_STAGE4A_STARTING_OFFSETS=earliest
SPARK_STAGE4A_MAX_OFFSETS_PER_TRIGGER=2000

# Stage 5A BigQuery warehouse contract / optional cloud loader
PHARMSTOCK_BQ_PROJECT=
PHARMSTOCK_BQ_DATASET=pharmstock_silver
PHARMSTOCK_BQ_LOCATION=EU
# Optional only when executing the cloud loader with explicit credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Stage 5B live deployment remains opt-in. Use ADC or an explicit credential file locally.
# Never commit credential JSON files.
PHARMSTOCK_BQ_REQUIRE_EXPLICIT_REPLACE=true

# Stage 5C dbt analytics / Gold layer
PHARMSTOCK_BQ_SOURCE_DATASET=pharmstock_silver
PHARMSTOCK_DBT_BASE_DATASET=pharmstock

# Future MLflow stage
MLFLOW_TRACKING_URI=http://localhost:5000

# Future AI service stage
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Stage 2A synthetic network
SIMULATION_RANDOM_SEED=20260822
PHARMACY_NETWORK_OUTPUT_DIR=artifacts/stage2a

# Stage 2B - optional for reliable/high-volume openFDA access.
# Never commit a real key. Set it in your shell or local .env only.
OPENFDA_API_KEY=

# Stage 2E synthetic demand replay defaults
DEMAND_SIMULATION_START_DATE=2026-08-22
DEMAND_SIMULATION_DAYS=7
DEMAND_SIMULATION_SEED=20260822

# Stage 2F.1 scalable synthetic supplier network
SUPPLIER_NATIONAL_COUNT=12
SUPPLIER_REGIONAL_PER_REGION=6
SUPPLIER_LOCAL_PER_GOVERNORATE=3
SUPPLIER_DIRECT_MANUFACTURER_COUNT=24
SUPPLIER_COLD_CHAIN_SPECIALIST_COUNT=12
SUPPLIER_PREFERRED_PANEL_SIZE=12

# Stage 5D governed master-data warehouse
PHARMSTOCK_BQ_MASTER_DATASET=pharmstock_master

# Stage 6A Power BI serving
PHARMSTOCK_PBI_DATASET=pharmstock_pbi

# Stage 7A Egypt-oriented public pharmaceutical market snapshot
PHARMSTOCK_EG_DRUG_SOURCE_URL=https://raw.githubusercontent.com/karem505/egyptian-drug-database/main/data/egyptian-drugs.csv
PHARMSTOCK_EG_DRUG_SNAPSHOT_LABEL=2026-06
PHARMSTOCK_EG_DRUG_MIN_PRODUCTS=20000

# Stage 7D local on-prem PostgreSQL operational/POS database
# These fallback values are for isolated local Docker development only.
# Override all passwords for any shared/non-local environment; never commit real secrets.
PHARMSTOCK_POSTGRES_PORT=5433
PHARMSTOCK_POSTGRES_PASSWORD=
PHARMSTOCK_APP_PASSWORD=
PHARMSTOCK_CDC_PASSWORD=

# Stage 7F Debezium CDC -> Kafka
PHARMSTOCK_CONNECT_PORT=8083

# Stage 7H BigQuery rebuild + dbt analytics
PHARMSTOCK_BQ_REBUILD_DATASET=pharmstock_ops_rebuild
# PHARMSTOCK_DBT_BASE_DATASET remains the dbt base prefix; Stage 7H creates
# <base>_rebuild_stg and <base>_rebuild_gold datasets.

# Stage 7I storage-safe continuous CDC -> BigQuery Sandbox
PHARMSTOCK_BQ_CDC_DATASET=pharmstock_cdc_delta
PHARMSTOCK_BQ_CURRENT_DATASET=pharmstock_ops_current
PHARMSTOCK_BQ_WARN_GIB=8.2
PHARMSTOCK_BQ_HARD_STOP_GIB=8.5
PHARMSTOCK_CDC_MAX_BATCH_RECORDS=50000
PHARMSTOCK_CDC_PARQUET_EXPANSION_FACTOR=6.0
# Stage 7K local-first ML + MLflow + model serving
PHARMSTOCK_BQ_GOLD_DATASET=pharmstock_rebuild_gold
PHARMSTOCK_ML_MAX_TRAINING_ROWS=500000
PHARMSTOCK_ML_MAX_QUERY_GIB=8.0
MLFLOW_TRACKING_URI=http://localhost:5001
PHARMSTOCK_MLFLOW_PORT=5001
PHARMSTOCK_ML_SERVING_URI=http://localhost:8090
PHARMSTOCK_ML_SERVING_PORT=8090


# Stage 7K.4 zero-cost cloud-ready blueprint (NO deployment by default)
PHARMSTOCK_CLOUD_REGION=europe-west1
PHARMSTOCK_ENABLE_BILLABLE_CLOUD=false

# Stage 7L governed operational decision workflow
# Override for any shared/non-local environment; never commit a real password.
PHARMSTOCK_DECISION_PASSWORD=
PHARMSTOCK_STAGE7L_CONSUMER_GROUP=pharmstock-stage7l-workflow-v1
PHARMSTOCK_STAGE7L_MAX_PROCESSING_BACKOFF_SECONDS=30
PHARMSTOCK_STAGE7L_HEARTBEAT_MAX_AGE_SECONDS=45

# Security-sensitive runtime credentials.
# Keep real values local and never commit them.
PHARMSTOCK_AIRFLOW_DB_PASSWORD=
PHARMSTOCK_AIRFLOW_ADMIN_USER=
PHARMSTOCK_AIRFLOW_ADMIN_PASSWORD=
PHARMSTOCK_STAGE7M_VIEWER_KEY=
PHARMSTOCK_STAGE7M_OPERATOR_KEY=
PHARMSTOCK_STAGE7O_STAGE7M_API_KEY=
PHARMSTOCK_STAGE7O_OPENAI_API_KEY=
